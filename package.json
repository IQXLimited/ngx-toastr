{
  "name": "@iqx-limited/ngx-toastr",
  "description": "Toastr for Angular",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IQXLimited/ngx-toastr.git"
  },
  "version": "4.0.0",
  "license": "MIT",
  "author": "IQX Limited",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "demo:build": "ng build demo --configuration production --no-progress --base-href 'https://iqxlimited.github.io/ngx-toastr/'",
    "sync-package": "node scripts/sync-lib-package.mjs",
    "prebuild": "npm run sync-package",
    "build": "ng-packagr -p projects/ngx-toastr/ng-package.json",
    "postbuild": "cpy README.md LICENSE CHANGELOG.md dist",
    "test": "npm run tsc-verify && ng test --watch=false",
    "test:watch": "ng test",
    "test:ci": "npm run tsc-verify && ng test --watch=false --code-coverage --no-progress --browsers=ChromeHeadlessCustom",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tsc-verify": "tsc --noEmit"
  },
  "private": true,
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.1.3",
    "@angular/language-service": "^22.1.3",
    "@angular/platform-browser": "^22.0.2",
    "@angular/router": "^22.1.3",
    "@ctrl/ngx-github-buttons": "^9.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jasmine": "^6.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "angular-eslint": "^22.1.0",
    "bootstrap": "^5.3.8",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.9.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^6.3.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "lodash-es": "^4.18.1",
    "ng-packagr": "^22.1.1",
    "puppeteer": "^25.8.0",
    "rxjs": "^7.8.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "release": {
    "branches": [
      "master"
    ]
  },
  "volta": {
    "node": "24.19.0"
  },
  "allowScripts": {
    "puppeteer@25.8.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.6.0": true
  }
}
